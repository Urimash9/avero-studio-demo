{
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/servicos/landing-pages", "destination": "/servicos/landing-pages/index.html" },
    { "source": "/servicos/sites-institucionais", "destination": "/servicos/sites-institucionais/index.html" },
    { "source": "/servicos/ecommerce-cardapios", "destination": "/servicos/ecommerce-cardapios/index.html" },
    { "source": "/servicos/seo-performance", "destination": "/servicos/seo-performance/index.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] }
  ]
}
